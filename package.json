{
  "name": "bookit",
  "private": true,
  "version": "1.0.0",
  "description": "Booking & Event Ticketing Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
