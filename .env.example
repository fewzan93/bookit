# Copy to .env and fill before `docker compose up`
# Public URL of the site (no trailing slash)
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# REQUIRED: 32+ random characters (openssl rand -hex 32)
JWT_SECRET=change-me-32-characters-minimum

# Stripe (leave empty => dev payment simulator)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP (leave empty => emails logged to console)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Bookit <noreply@bookit.local>

# Cloudinary (leave empty => local /uploads volume)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
