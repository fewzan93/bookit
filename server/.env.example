NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/bookit
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
